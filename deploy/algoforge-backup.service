[Unit]
Description=AlgoForge backup snapshot
After=network.target

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/algoforge
Environment="PATH=/home/ec2-user/algoforge/venv/bin"
EnvironmentFile=/home/ec2-user/algoforge/.env
ExecStart=/home/ec2-user/algoforge/venv/bin/python /home/ec2-user/algoforge/scripts/backup_algoforge.py
