# ═══════════════════════════════════════════════════════════════
#  AlgoForge Staging — dedicated systemd unit
#  Uses a separate worktree and env file so staging never mutates
#  the live production checkout or live blue-green services.
# ═══════════════════════════════════════════════════════════════
[Unit]
Description=AlgoForge Staging FastAPI Backend
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/algoforge-staging
Environment="PATH=/home/ec2-user/algoforge-staging/venv/bin"
EnvironmentFile=/home/ec2-user/algoforge-staging/.env.staging
ExecStart=/home/ec2-user/algoforge-staging/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8002 --workers 1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
