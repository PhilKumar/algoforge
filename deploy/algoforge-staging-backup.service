[Unit]
Description=AlgoForge staging backup snapshot
After=network.target

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/algoforge-staging
Environment="PATH=/home/ec2-user/algoforge-staging/venv/bin"
EnvironmentFile=/home/ec2-user/algoforge-staging/.env.staging
ExecStart=/home/ec2-user/algoforge-staging/venv/bin/python /home/ec2-user/algoforge-staging/scripts/backup_algoforge.py
