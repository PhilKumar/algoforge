# ============================================================
#  AlgoForge — Staging Environment Template
#  Used by /home/ec2-user/algoforge-staging on feature/multi-tenant
# ============================================================

# ── App ──────────────────────────────────────────────────────
DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8002
ALGOFORGE_SKIP_STARTUP_JOBS=true

# ── Admin Bootstrap (first run only) ────────────────────────
ADMIN_USERNAME=admin
ALGOFORGE_PIN=change_me_before_first_boot

# ── Multi-Tenant Storage ────────────────────────────────────
ALGOFORGE_DB=/home/ec2-user/algoforge-staging/algoforge-staging.db
ALGOFORGE_USER_DATA_ROOT=/home/ec2-user/algoforge-staging/data/users
ALGOFORGE_BACKUP_ROOT=/home/ec2-user/algoforge-staging/backups
ALGOFORGE_BACKUP_RETENTION_DAYS=7

# ── Session / Lockout Policy ────────────────────────────────
SESSION_TTL_HOURS=24
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5

# ── Encryption (required for stored broker creds) ───────────
# Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Optional auth-page CTA for opening a new Dhan account
DHAN_REFERRAL_URL=

# ── Broker (optional for staging; leave blank if testing paper only) ──
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_PIN=
DHAN_TOTP_SECRET=

# ── Alerts (optional) ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
