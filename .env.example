# ============================================================
#  PhilForge — Environment Configuration Template
#  Copy this to .env and fill in your actual values
# ============================================================

# ── Dhan API Credentials ────────────────────────────────────
# Get these from: https://dhanhq.co → API → Generate Token
DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_access_token_here
DHAN_PIN=
DHAN_TOTP_SECRET=

# ── Application Settings ────────────────────────────────────
DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000

# ── Multi-Tenant Auth & Storage ─────────────────────────────
# First-run bootstrap only: used only when no admin user exists yet.
ADMIN_USERNAME=admin
PHILFORGE_PIN=
# Alternative first-run bootstrap name if you prefer a non-PIN password.
PHILFORGE_PASSWORD=

# SQLite database and per-user storage roots
PHILFORGE_DB=
PHILFORGE_USER_DATA_ROOT=

# Required for encrypted broker credential storage
# Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Optional auth-page CTA for opening a new Dhan account
DHAN_REFERRAL_URL=

# Session / lockout policy
SESSION_TTL_HOURS=24
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5

# Backups
PHILFORGE_BACKUP_ROOT=
PHILFORGE_BACKUP_RETENTION_DAYS=14
PHILFORGE_BACKUP_MIN_FREE_MB=1024
# Optional encrypted off-host copy. The EC2 role/user needs write access.
PHILFORGE_BACKUP_S3_URI=
# Optional AWS KMS key ID/ARN. When blank, S3 AES-256 encryption is used.
PHILFORGE_BACKUP_S3_KMS_KEY_ID=

# Shared, append-only raw option-bar archive used by replays and exports.
PHILFORGE_OPTION_ARCHIVE_ROOT=

# Local testing helper
PHILFORGE_SKIP_STARTUP_JOBS=false

# ── Alerts (optional) ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
